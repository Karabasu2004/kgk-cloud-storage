NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/kgk-cloud-storage
JWT_SECRET=replace-with-a-local-only-secret-of-at-least-32-bytes
AWS_REGION=us-east-1
AWS_S3_BUCKET=replace-with-your-private-bucket-name
AWS_ACCESS_KEY_ID=replace-with-a-local-development-access-key
AWS_SECRET_ACCESS_KEY=replace-with-a-local-development-secret-key
FRONTEND_URL=http://localhost:5173
PUBLIC_API_BASE_URL=http://localhost:5000/api
MAX_UPLOAD_SIZE_BYTES=52428800
